# Copiar a .env.operational solo para una integración autorizada.
STOCK_ENV=operational
STOCK_OPERATIONAL_MYSQL_HOST=localhost
STOCK_OPERATIONAL_MYSQL_PORT=3306
STOCK_OPERATIONAL_MYSQL_USER=example_user
STOCK_OPERATIONAL_MYSQL_PASSWORD=change_me
STOCK_OPERATIONAL_PROVIDERS_MYSQL_HOST=localhost
STOCK_OPERATIONAL_PROVIDERS_MYSQL_PORT=3306
STOCK_OPERATIONAL_PROVIDERS_MYSQL_USER=example_user
STOCK_OPERATIONAL_PROVIDERS_MYSQL_PASSWORD=change_me
SECRET_MASTER_PASSWORD=change_me
SECRET_SALT=example_salt
STOCK_SMTP_HOST=localhost
STOCK_SMTP_PORT=587
STOCK_SMTP_USER=example_user
STOCK_SMTP_PASSWORD=change_me
STOCK_EMAIL_TO=operator@example.invalid
STOCK_PROVIDER_IDS=
STOCK_EXCLUDED_PROVIDER_IDS=
STOCK_SHOP_MANAGEMENT_PROVIDER_IDS=
STOCK_OPERATIONAL_WRITES_AUTHORIZED=NO
STOCK_OPEN_QUANTITY_PROVIDER_ID=
STOCK_FTPS_PROVIDER_ID=
